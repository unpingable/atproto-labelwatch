# /etc/labelwatch-recent.env (mode 0640 root:labelwatch). Example only.
# Shared by the collect, maintain and product units and by recent_init.py.

# The single admitted root. Absolute, existing, no symlinked component, not /,
# disjoint from the qualification campaign roots. Must equal ReadWritePaths=.
LABELWATCH_RECENT_ADMITTED_ROOT=/REPLACE_WITH_ADMITTED_RECENT_ROOT
# The store: a strict child of the admitted root, created by recent_init.py.
LABELWATCH_RECENT_STORE=/REPLACE_WITH_ADMITTED_RECENT_ROOT/epoch-2

# Per-filesystem free-space reserves (bytes). Every listed mount must exist;
# the store's filesystem must be listed. Unset/empty/malformed = refusal.
# Example below is a root-only host (no /data); size it from the measured peak.
LABELWATCH_RECENT_RESERVES=[{"mount":"/","bytes":21474836480}]
# Alternatively: LABELWATCH_RECENT_RESERVES_FILE=/etc/labelwatch-recent-reserves.json
# Minimum free inodes on every listed filesystem (default 1000000).
LABELWATCH_RECENT_MIN_FREE_INODES=1000000
# Only for a deliberate, reviewed weakening of the policy recorded at init:
# sha256(recorded q:recent_reserves + "\n" + running canonical policy); any
# later change to the running policy voids it. Leave unset.
#LABELWATCH_RECENT_RESERVES_OVERRIDE_ACK=

# Observation window; only 30 is implemented.
LABELWATCH_RECENT_WINDOW_DAYS=30
# Roster seed used once by recent_init.py (DIDs only, no cursors).
LABELWATCH_RECENT_ROSTER=/opt/labelwatch/releases/REPLACE_WITH_RELEASE_SHA/source/deploy/roster-epoch2-seed.json
LABELWATCH_GIT_SHA=REPLACE_WITH_RELEASE_SHA

# Public aggregate publication directory (created 0755 by the overview publisher; the facts API
# account must be able to traverse it). Point FACTSAPI_LABELWATCH_OVERVIEW at ${LABELWATCH_RECENT_PUBDIR}/overview.json.
LABELWATCH_RECENT_PUBDIR=/REPLACE_WITH_PUBLIC_OVERVIEW_DIR
