[Unit]
Description=labelwatch - ATProto labeler behavior monitor
After=network.target

[Service]
Type=simple
User=labelwatch
Group=labelwatch
WorkingDirectory=/opt/labelwatch
ExecStart=/opt/labelwatch/.venv/bin/labelwatch \
    --config /opt/labelwatch/config.toml \
    --db /var/lib/labelwatch/labelwatch.db \
    run --ingest-interval 120 \
    --scan-interval 300 \
    --report-out /var/www/labelwatch
Restart=always
RestartSec=5
# Restart=always handles process/OOM exits. "restart" is not a valid
# OOMPolicy value; explicit stop matches systemd's prior effective default.
OOMPolicy=stop
TimeoutStopSec=30

# Resource limits
MemoryMax=2G
CPUQuota=50%

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/labelwatch /var/www
ProtectHome=true

[Install]
WantedBy=multi-user.target
